<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_panel"
    android:orientation="vertical">

    <!-- Baris gaya trading: pilihan paling atas karena menentukan BOBOT skor
         (daytrade menekankan likuiditas & aliran dana, swing menekankan tren)
         sekaligus menentukan preset penyaring apa saja yang tersedia. -->
    <HorizontalScrollView
        android:id="@+id/svScreenerStyles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/llScreenerStyles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Baris preset penyaringan -->
    <HorizontalScrollView
        android:id="@+id/svScreenerPresets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/llScreenerPresets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Baris pemilih timeframe: M15 (intraday) / 1BL / 3BL / 6BL (dalam bulan).
         Fibonacci & struktur pasar dihitung ulang sesuai timeframe yang dipilih.
         Dibuat bisa digeser karena 4 chip + keterangan horizon bisa melebihi lebar layar. -->
    <HorizontalScrollView
        android:id="@+id/svScreenerTimeframes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_panel"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/llScreenerTimeframes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Catatan keterbatasan data -->
    <TextView
        android:id="@+id/tvScreenerNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp"
        android:text="⚠️ Skor 0-100 dari Volume·Bandar·MACD·RSI·MA·Fibonacci·SMC·Struktur. Data IDX delay 10-15 mnt — untuk menyaring kandidat, bukan pemicu entry."
        android:textColor="@color/signal_yellow"
        android:textSize="10sp" />

    <!-- Pencarian kode / nama saham: langsung menilai emiten yang dicari
         (melewati filter preset), memakai bobot gaya trading yang aktif. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">

        <EditText
            android:id="@+id/etScreenerSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:hint="🔍 Cari kode / nama saham (mis. BBCA, bank)"
            android:imeOptions="actionSearch"
            android:inputType="textCapCharacters"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:paddingVertical="7dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvScreenerSearchClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:paddingVertical="7dp"
            android:text="✕"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Penanda mode pencarian + progres unduh universe (268 KB sekali saja) -->
    <TextView
        android:id="@+id/tvScreenerSearchHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingBottom="4dp"
        android:textColor="@color/brand_accent"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- Progress -->
    <ProgressBar
        android:id="@+id/pbScreenerLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvScreener"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <!-- Empty / status -->
        <LinearLayout
            android:id="@+id/layoutScreenerEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/tvScreenerEmptyMsg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Pilih preset di atas untuk menyaring kandidat dari 844 emiten IDX."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
