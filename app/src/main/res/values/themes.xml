<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AppScalping" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/bg_panel</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bg_panel</item>
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorSecondary">@color/brand_accent</item>
    </style>

    <!-- Label tab diperkecil agar 5 tab (Manual/Movers/Top Picks/Screener/Port) muat
         dengan tabMode="fixed" tanpa terpotong di layar sempit. -->
    <style name="TabTextAppearance.AppScalping" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
