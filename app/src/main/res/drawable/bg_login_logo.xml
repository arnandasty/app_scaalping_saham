<?xml version="1.0" encoding="utf-8"?>
<!-- Lencana logo: lingkaran gradien brand dengan cincin cahaya. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <size
                android:width="96dp"
                android:height="96dp" />
            <gradient
                android:angle="315"
                android:startColor="#0EA5E9"
                android:endColor="#38BDF8" />
            <stroke
                android:width="2dp"
                android:color="#66E0F2FE" />
        </shape>
    </item>

    <item
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#0B1120"
                android:endColor="#0E1B33" />
        </shape>
    </item>
</layer-list>
